{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "ApprovalStatus": {
      "enum": [
        "draft",
        "reviewed",
        "approved"
      ],
      "title": "ApprovalStatus",
      "type": "string"
    },
    "ChampionshipStation": {
      "additionalProperties": false,
      "properties": {
        "speed": {
          "items": {
            "$ref": "#/$defs/Question"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Speed",
          "type": "array"
        },
        "accuracy": {
          "items": {
            "$ref": "#/$defs/Question"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Accuracy",
          "type": "array"
        },
        "thinking": {
          "items": {
            "$ref": "#/$defs/Question"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Thinking",
          "type": "array"
        }
      },
      "required": [
        "speed",
        "accuracy",
        "thinking"
      ],
      "title": "ChampionshipStation",
      "type": "object"
    },
    "Concept": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "title": "Concept",
      "type": "object"
    },
    "ConceptLink": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "title": "Source",
          "type": "string"
        },
        "target": {
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "title": "Target",
          "type": "string"
        },
        "label": {
          "default": "",
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "source",
        "target"
      ],
      "title": "ConceptLink",
      "type": "object"
    },
    "ConnectStation": {
      "additionalProperties": false,
      "properties": {
        "case": {
          "$ref": "#/$defs/Content"
        },
        "decisions": {
          "items": {
            "$ref": "#/$defs/Decision"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Decisions",
          "type": "array"
        },
        "bridge": {
          "$ref": "#/$defs/Content"
        },
        "summary": {
          "$ref": "#/$defs/Content"
        }
      },
      "required": [
        "case",
        "decisions",
        "bridge",
        "summary"
      ],
      "title": "ConnectStation",
      "type": "object"
    },
    "ConnectTask": {
      "additionalProperties": false,
      "description": "Links a new concept to prior knowledge; the link is animated after the reveal.",
      "properties": {
        "question": {
          "$ref": "#/$defs/Question"
        },
        "new_concept": {
          "default": "",
          "title": "New Concept",
          "type": "string"
        },
        "prior_concept": {
          "default": "",
          "title": "Prior Concept",
          "type": "string"
        }
      },
      "required": [
        "question"
      ],
      "title": "ConnectTask",
      "type": "object"
    },
    "Content": {
      "additionalProperties": false,
      "description": "Something shown on screen: text, a media file, or both.",
      "properties": {
        "title": {
          "default": "",
          "title": "Title",
          "type": "string"
        },
        "text": {
          "default": "",
          "title": "Text",
          "type": "string"
        },
        "media_id": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Media Id"
        }
      },
      "title": "Content",
      "type": "object"
    },
    "CrackStation": {
      "additionalProperties": false,
      "properties": {
        "locks": {
          "items": {
            "$ref": "#/$defs/Lock"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Locks",
          "type": "array"
        },
        "vault_message": {
          "minLength": 1,
          "title": "Vault Message",
          "type": "string"
        }
      },
      "required": [
        "locks",
        "vault_message"
      ],
      "title": "CrackStation",
      "type": "object"
    },
    "Decision": {
      "additionalProperties": false,
      "description": "A decision point with exactly two options. A tie goes to ``tie_default``.",
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "title": "Id",
          "type": "string"
        },
        "prompt": {
          "minLength": 1,
          "title": "Prompt",
          "type": "string"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/DecisionOption"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Options",
          "type": "array"
        },
        "tie_default": {
          "default": 0,
          "maximum": 1,
          "minimum": 0,
          "title": "Tie Default",
          "type": "integer"
        },
        "vote_seconds": {
          "anyOf": [
            {
              "maximum": 300,
              "minimum": 5,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vote Seconds"
        }
      },
      "required": [
        "id",
        "prompt",
        "options"
      ],
      "title": "Decision",
      "type": "object"
    },
    "DecisionOption": {
      "additionalProperties": false,
      "description": "One path: what happened after the choice, and what it teaches.",
      "properties": {
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "outcome": {
          "$ref": "#/$defs/Content"
        },
        "analysis": {
          "$ref": "#/$defs/Content"
        }
      },
      "required": [
        "label",
        "outcome",
        "analysis"
      ],
      "title": "DecisionOption",
      "type": "object"
    },
    "Difficulty": {
      "enum": [
        "easy",
        "medium",
        "hard"
      ],
      "title": "Difficulty",
      "type": "string"
    },
    "DiscoverStation": {
      "additionalProperties": false,
      "properties": {
        "identify": {
          "$ref": "#/$defs/Key"
        },
        "understand": {
          "$ref": "#/$defs/Key"
        },
        "distinguish": {
          "$ref": "#/$defs/Key"
        }
      },
      "required": [
        "identify",
        "understand",
        "distinguish"
      ],
      "title": "DiscoverStation",
      "type": "object"
    },
    "DistinguishTask": {
      "additionalProperties": false,
      "properties": {
        "question": {
          "$ref": "#/$defs/Question"
        },
        "examples": {
          "items": {
            "$ref": "#/$defs/Content"
          },
          "maxItems": 2,
          "title": "Examples",
          "type": "array"
        }
      },
      "required": [
        "question"
      ],
      "title": "DistinguishTask",
      "type": "object"
    },
    "IdentityCard": {
      "additionalProperties": false,
      "description": "Who the game is for and what it should achieve.\n\nFeeds the review agent, the facilitator guide and the look of the game.",
      "properties": {
        "subject": {
          "minLength": 1,
          "title": "Subject",
          "type": "string"
        },
        "topic": {
          "minLength": 1,
          "title": "Topic",
          "type": "string"
        },
        "age_min": {
          "maximum": 120,
          "minimum": 3,
          "title": "Age Min",
          "type": "integer"
        },
        "age_max": {
          "maximum": 120,
          "minimum": 3,
          "title": "Age Max",
          "type": "integer"
        },
        "grades": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Grades",
          "type": "array"
        },
        "mode": {
          "$ref": "#/$defs/Mode"
        },
        "theme": {
          "$ref": "#/$defs/Theme"
        },
        "prior_knowledge": {
          "default": "",
          "title": "Prior Knowledge",
          "type": "string"
        },
        "learning_goals": {
          "items": {
            "$ref": "#/$defs/LearningGoal"
          },
          "maxItems": 6,
          "minItems": 4,
          "title": "Learning Goals",
          "type": "array"
        },
        "participants": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Participants"
        },
        "notes": {
          "default": "",
          "title": "Notes",
          "type": "string"
        }
      },
      "required": [
        "subject",
        "topic",
        "age_min",
        "age_max",
        "grades",
        "mode",
        "theme",
        "learning_goals"
      ],
      "title": "IdentityCard",
      "type": "object"
    },
    "Key": {
      "additionalProperties": false,
      "description": "A knowledge key: short knowledge, a question, and help if the class gets it wrong.\n\nIn learning mode the knowledge is shown before the question; in review mode after.",
      "properties": {
        "knowledge": {
          "$ref": "#/$defs/Content"
        },
        "examples": {
          "items": {
            "$ref": "#/$defs/Content"
          },
          "maxItems": 2,
          "title": "Examples",
          "type": "array"
        },
        "question": {
          "$ref": "#/$defs/Question"
        },
        "confirm_question": {
          "anyOf": [
            {
              "$ref": "#/$defs/Question"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "key_word": {
          "minLength": 1,
          "title": "Key Word",
          "type": "string"
        }
      },
      "required": [
        "knowledge",
        "question",
        "key_word"
      ],
      "title": "Key",
      "type": "object"
    },
    "KnowledgeMap": {
      "additionalProperties": false,
      "description": "The closing concept map. The teacher writes it; the player only draws it.",
      "properties": {
        "central": {
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "title": "Central",
          "type": "string"
        },
        "concepts": {
          "items": {
            "$ref": "#/$defs/Concept"
          },
          "maxItems": 5,
          "minItems": 3,
          "title": "Concepts",
          "type": "array"
        },
        "links": {
          "items": {
            "$ref": "#/$defs/ConceptLink"
          },
          "minItems": 1,
          "title": "Links",
          "type": "array"
        },
        "principle": {
          "minLength": 1,
          "title": "Principle",
          "type": "string"
        },
        "example": {
          "minLength": 1,
          "title": "Example",
          "type": "string"
        },
        "takeaway": {
          "minLength": 1,
          "title": "Takeaway",
          "type": "string"
        }
      },
      "required": [
        "central",
        "concepts",
        "links",
        "principle",
        "example",
        "takeaway"
      ],
      "title": "KnowledgeMap",
      "type": "object"
    },
    "LearningGoal": {
      "additionalProperties": false,
      "description": "A learning outcome that can be checked.",
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "title": "Id",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "id",
        "text"
      ],
      "title": "LearningGoal",
      "type": "object"
    },
    "Lock": {
      "additionalProperties": false,
      "description": "A knowledge lock. Opening it adds ``token`` to the vault code.",
      "properties": {
        "question": {
          "$ref": "#/$defs/Question"
        },
        "hint": {
          "minLength": 1,
          "title": "Hint",
          "type": "string"
        },
        "confirm_question": {
          "anyOf": [
            {
              "$ref": "#/$defs/Question"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "token": {
          "minLength": 1,
          "title": "Token",
          "type": "string"
        }
      },
      "required": [
        "question",
        "hint",
        "token"
      ],
      "title": "Lock",
      "type": "object"
    },
    "MediaItem": {
      "additionalProperties": false,
      "description": "A video or image file shipped inside the offline game package.",
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/MediaKind"
        },
        "src": {
          "minLength": 1,
          "title": "Src",
          "type": "string"
        },
        "duration_seconds": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Seconds"
        },
        "captions": {
          "default": false,
          "title": "Captions",
          "type": "boolean"
        },
        "narration": {
          "default": false,
          "title": "Narration",
          "type": "boolean"
        },
        "version": {
          "default": 1,
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "kind",
        "src"
      ],
      "title": "MediaItem",
      "type": "object"
    },
    "MediaKind": {
      "enum": [
        "video",
        "image"
      ],
      "title": "MediaKind",
      "type": "string"
    },
    "Mode": {
      "description": "How the session is used (REQUIREMENTS section 4).",
      "enum": [
        "learning",
        "review"
      ],
      "title": "Mode",
      "type": "string"
    },
    "Question": {
      "additionalProperties": false,
      "description": "A multiple-choice question: two to four answers, exactly one correct, with a rationale.\n\n\"Exactly one correct\" holds by construction: the model stores a single index.",
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "title": "Id",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "answers": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 4,
          "minItems": 2,
          "title": "Answers",
          "type": "array"
        },
        "correct_index": {
          "maximum": 3,
          "minimum": 0,
          "title": "Correct Index",
          "type": "integer"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "reinforcement": {
          "default": "",
          "title": "Reinforcement",
          "type": "string"
        },
        "vote_seconds": {
          "anyOf": [
            {
              "maximum": 300,
              "minimum": 5,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vote Seconds"
        },
        "media_id": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Media Id"
        },
        "difficulty": {
          "$ref": "#/$defs/Difficulty",
          "default": "medium"
        },
        "tags": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        }
      },
      "required": [
        "id",
        "text",
        "answers",
        "correct_index",
        "rationale"
      ],
      "title": "Question",
      "type": "object"
    },
    "RetrieveStation": {
      "additionalProperties": false,
      "properties": {
        "recall": {
          "items": {
            "$ref": "#/$defs/Question"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Recall",
          "type": "array"
        },
        "distinguish": {
          "items": {
            "$ref": "#/$defs/DistinguishTask"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Distinguish",
          "type": "array"
        },
        "connect": {
          "items": {
            "$ref": "#/$defs/ConnectTask"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Connect",
          "type": "array"
        }
      },
      "required": [
        "recall",
        "distinguish",
        "connect"
      ],
      "title": "RetrieveStation",
      "type": "object"
    },
    "SealStation": {
      "additionalProperties": false,
      "description": "The anchor returns (stored on the game), then a transfer question and the map.",
      "properties": {
        "transfer_question": {
          "$ref": "#/$defs/Question"
        },
        "knowledge_map": {
          "$ref": "#/$defs/KnowledgeMap"
        },
        "closing_message": {
          "default": "",
          "title": "Closing Message",
          "type": "string"
        }
      },
      "required": [
        "transfer_question",
        "knowledge_map"
      ],
      "title": "SealStation",
      "type": "object"
    },
    "SparkStation": {
      "additionalProperties": false,
      "description": "Opening video, the anchor question (stored on the game) and the opening goals.",
      "properties": {
        "opening_media_id": {
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "title": "Opening Media Id",
          "type": "string"
        },
        "opening_goals": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 2,
          "title": "Opening Goals",
          "type": "array"
        }
      },
      "required": [
        "opening_media_id",
        "opening_goals"
      ],
      "title": "SparkStation",
      "type": "object"
    },
    "Stations": {
      "additionalProperties": false,
      "description": "The seven stations. Named fields, so the fixed order cannot be broken.",
      "properties": {
        "spark": {
          "$ref": "#/$defs/SparkStation"
        },
        "discover": {
          "$ref": "#/$defs/DiscoverStation"
        },
        "retrieve": {
          "$ref": "#/$defs/RetrieveStation"
        },
        "connect": {
          "$ref": "#/$defs/ConnectStation"
        },
        "crack": {
          "$ref": "#/$defs/CrackStation"
        },
        "championship": {
          "$ref": "#/$defs/ChampionshipStation"
        },
        "seal": {
          "$ref": "#/$defs/SealStation"
        }
      },
      "required": [
        "spark",
        "discover",
        "retrieve",
        "connect",
        "crack",
        "championship",
        "seal"
      ],
      "title": "Stations",
      "type": "object"
    },
    "Theme": {
      "description": "The landscape \"skin\" of the game (ADR 0005).",
      "enum": [
        "city",
        "forest",
        "beach",
        "desert"
      ],
      "title": "Theme",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "A complete game: identity card, key ideas, the anchor question and seven stations.",
  "properties": {
    "schema_version": {
      "const": 2,
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "version": {
      "default": 1,
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    },
    "status": {
      "$ref": "#/$defs/ApprovalStatus",
      "default": "draft"
    },
    "identity": {
      "$ref": "#/$defs/IdentityCard"
    },
    "key_ideas": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 5,
      "minItems": 3,
      "title": "Key Ideas",
      "type": "array"
    },
    "anchor_question": {
      "$ref": "#/$defs/Question"
    },
    "media": {
      "items": {
        "$ref": "#/$defs/MediaItem"
      },
      "title": "Media",
      "type": "array"
    },
    "stations": {
      "$ref": "#/$defs/Stations"
    }
  },
  "required": [
    "title",
    "identity",
    "key_ideas",
    "anchor_question",
    "stations"
  ],
  "title": "Game",
  "type": "object"
}
